{
  "hooks": {
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/skills/autodidact/scripts/detect_complexity.py" },
        { "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/skills/autodidact/scripts/detect_pending_completion.py" },
        { "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/skills/autodidact/scripts/detect_staleness.py" }
      ]}
    ],
    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/skills/autodidact/scripts/inject_reminder.py" },
        { "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/skills/autodidact/scripts/detect_domain_recurrence.py" }
      ]}
    ],
    "SessionStart": [
      { "hooks": [
        { "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/skills/autodidact/scripts/list_pending.py" }
      ]}
    ]
  }
}
